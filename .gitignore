.venv/
__pycache__/
*.py[cod]
.env
.pytest_cache/
.ruff_cache/
.ty_cache/

# `.streamlit/config.toml` is the theme and *is* committed. Secrets are the
# other file that directory attracts, and this app has none — credentials come
# from `.env`. Listed anyway so adding one later cannot commit it by reflex.
.streamlit/secrets.toml

# Agent scratch space. Mostly regenerated per run, but checkpoints.db holds
# durable conversation state — deleting it discards every thread `--thread`
# could resume.
workspace/

# SQLite databases and their WAL sidecars outside workspace/ — a stray backup
# of checkpoints.db holds every thread's full transcript.
*.db
*.db-wal
*.db-shm

# Claude Code's per-user permission approvals. Ignored on the author's machine
# only through a global git ignore, which a clone does not inherit.
.claude/settings.local.json

# Build output from `uv build`.
dist/

# macOS Finder metadata.
.DS_Store
