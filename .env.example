# Copy to .env and fill in. .env is gitignored.

# Required — the agent will not start without this.
ANTHROPIC_API_KEY=sk-ant-...

# Recommended: LangSmith tracing. These are the current env var names, and they
# win where both are set. The older LANGCHAIN_* spellings still work as
# fallbacks -- a stale LANGCHAIN_TRACING_V2=true left in a shell profile starts
# billing traces even with nothing about LangSmith in this file.
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=real-estate-agent

# Optional model overrides. Keep the "provider:model" prefix: the app reads it
# to decide which API key to require, and assumes Anthropic without one.
# REA_MODEL=anthropic:claude-opus-5-5
# REA_SUBAGENT_MODEL=anthropic:claude-opus-5-5

# Optional: one specialist on its own model. Each falls back to
# REA_SUBAGENT_MODEL, and an empty value counts as unset. Same prefix rule:
# a role on another provider needs that provider's key, and is checked for it.
# REA_MODEL_PROPERTY_SEARCH=anthropic:claude-haiku-5-5
# REA_MODEL_MARKET_ANALYST=anthropic:claude-opus-5-5
# REA_MODEL_DOCUMENT_REVIEWER=anthropic:claude-opus-5-5
# REA_MODEL_CLIENT_LIAISON=anthropic:claude-sonnet-5-5

# Optional effort: low, medium, high, xhigh or max; anything else stops the app
# at startup. Unset sends none, so the API default applies (medium on Opus 5.5,
# high on Sonnet 5.5). REA_EFFORT is the orchestrator's; each specialist falls
# back REA_EFFORT_<ROLE> -> REA_SUBAGENT_EFFORT -> REA_EFFORT.
# REA_EFFORT=medium
# REA_SUBAGENT_EFFORT=low
# REA_EFFORT_PROPERTY_SEARCH=low
# REA_EFFORT_MARKET_ANALYST=high
# REA_EFFORT_DOCUMENT_REVIEWER=high
# REA_EFFORT_CLIENT_LIAISON=low
