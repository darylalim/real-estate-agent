# Copy to .env and fill in. .env is gitignored.

# Required — the agent will not start without this.
ANTHROPIC_API_KEY=sk-ant-...

# Recommended: LangSmith tracing. These are the current env var names;
# older LANGCHAIN_* names no longer work.
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=real-estate-agent

# Optional model overrides. LangChain needs the "provider:model" prefix.
# REA_MODEL=anthropic:claude-opus-5
# REA_SUBAGENT_MODEL=anthropic:claude-opus-5
