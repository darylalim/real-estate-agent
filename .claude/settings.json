{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)",
      "Read(./.streamlit/secrets.toml)",
      "Edit(./.streamlit/secrets.toml)",
      "Write(./.streamlit/secrets.toml)",
      "Edit(./uv.lock)",
      "Write(./uv.lock)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/confirm-live-run.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/done-gate.sh",
            "statusMessage": "scripts/check.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
